[Unit]
Description=Schulplaner WebUntis Monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=stundenplan
Group=stundenplan
WorkingDirectory=/srv/apps/stundenplaninfo/app
Environment=PYTHONPATH=/srv/apps/stundenplaninfo/app/src
Environment=APP_HOST=127.0.0.1
Environment=APP_PORT=8000
ExecStart=/srv/apps/stundenplaninfo/app/.venv/bin/python -m milo_webuntis.app
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/srv/apps/stundenplaninfo/app/data /srv/apps/stundenplaninfo/app/.env

[Install]
WantedBy=multi-user.target
