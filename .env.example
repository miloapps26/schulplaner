# WebUntis
WEBUNTIS_SERVER=example.webuntis.com
WEBUNTIS_SCHOOL=example-school
WEBUNTIS_USERNAME=
WEBUNTIS_PASSWORD=
# Fuer IServ/SSO-Schulen oft besser: WebUntis Profil > Freigaben > App/QR-Schluessel
WEBUNTIS_APP_SECRET=
WEBUNTIS_SCHOOL_NUMBER=
# WebUntis Elementtypen: 1 = Klasse, 2 = Lehrkraft, 4 = Raum, 5 = Student.
WEBUNTIS_ELEMENT_TYPE=5
WEBUNTIS_ELEMENT_ID=
# Optional nur fuer Klassenabruf per Name:
WEBUNTIS_CLASS_NAME=

# Klassenarbeiten aus IServ Kalender > Klausurplan.
# Bei IServ/SSO-Schulen kann der WebUntis/IServ-Login wiederverwendet werden.
ISERV_EXAMS_ENABLED=true
ISERV_BASE_URL=https://example-iserv.de
ISERV_USERNAME=
ISERV_PASSWORD=

# Abfrage
POLL_INTERVAL_MINUTES=15
TRANSIT_POLL_INTERVAL_MINUTES=2
DAYS_BACK=0
DAYS_AHEAD=7
NOTIFY_ON_FIRST_RUN=false
TIMEZONE=Europe/Berlin

# Busfahrplan ueber GTFS: kostenlose Soll-Fahrplandaten, keine Live-Verspaetungen.
# Geofox wird in auto bevorzugt; bei Fehlern faellt die App auf GTFS zurueck.
TRANSIT_PROVIDER_MODE=auto
GEOFOX_BASE_URL=https://gti.geofox.de
GEOFOX_USERNAME=
GEOFOX_PASSWORD=
GEOFOX_API_VERSION=63
GEOFOX_TIMEOUT_SECONDS=15
GEOFOX_CACHE_SECONDS=60
GEOFOX_MIN_INTERVAL_SECONDS=1.1
GTFS_FEED_URL=https://download.gtfs.de/germany/nv_free/latest.zip
GTFS_CACHE_DIR=data/gtfs
GTFS_CACHE_MINUTES=1440
GTFS_DOWNLOAD_TIMEOUT_SECONDS=300

# E-Mail, mehrere Empfaenger mit Komma oder Semikolon trennen
SMTP_HOST=mail.gmx.net
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Schulplaner <stundenplaninfo@example.com>
SMTP_REPLY_TO=
SMTP_USE_TLS=true
EMAIL_TO=

# WhatsApp via Twilio, mehrere Empfaenger mit Komma oder Semikolon trennen
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
WHATSAPP_TO=

# Alternativ/zusaetzlich: eigener WhatsApp- oder Automation-Webhook
NOTIFICATION_WEBHOOK_URL=

# Optional
APP_HOST=127.0.0.1
APP_PORT=8000
DATA_DIR=data
MILO_CI_DIR=
TENANT_ID=default
TENANT_NAME=Stundenplan
TENANT_PUBLIC_ID=
PARENT_EMAIL=
STUDENT_FIRST_NAME=
STUDENT_LAST_NAME=
SCHOOL_LABEL=
CLASS_LABEL=
# Optional: mehrere Profile/Mandanten als JSON-Datei, echte Datei nicht committen.
TENANTS_FILE=config/tenants.json

# Milo/Authentik Anmeldung fuer /admin und Admin-APIs.
# Eltern melden sich weiterhin mit ihrem hinterlegten WebUntis-Zugang an.
# Stage und Prod brauchen getrennte Authentik-Anwendungen mit eigenen Secrets
# und eigenen Callback-URLs.
MILO_AUTH_REQUIRED=false
MILO_OIDC_ISSUER=https://auth.example.com/application/o/schulplaner/
MILO_OIDC_CLIENT_ID=
MILO_OIDC_CLIENT_SECRET=
MILO_OIDC_REDIRECT_URI=http://127.0.0.1:8000/auth/callback
MILO_OIDC_ADMIN_GROUP=milo-admins
MILO_OIDC_USER_GROUP=milo-webuntis-users
MILO_SESSION_SECRET=bitte-langen-zufallswert-setzen
MILO_COOKIE_SECURE=false
MILO_IDLE_TIMEOUT_MINUTES=30

# Nur fuer lokale Admin-Entwicklung, technisch deaktiviert wenn MILO_AUTH_REQUIRED=true.
# Der Eltern-Login per WebUntis-Zugang bleibt davon unberuehrt.
MILO_AUTH_USERS=admin=bitte-langes-passwort-setzen
MILO_AUTH_SECRET=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Oeffentliche App-Basis fuer Benachrichtigungen und Einladungen.
PUBLIC_TIMETABLE_URL=

# Optional fuer Hosting: echte Domain/FQDN eintragen, mehrere Werte mit Komma trennen.
ALLOWED_HOSTS=*
